{
  "entities": {
    "spotPhoto": {
      "title": "Spot Photo",
      "description": "User-contributed photo for a tourist spot in Dinajpur",
      "type": "object",
      "properties": {
        "spotId": {
          "type": "string",
          "description": "The unique ID of the spot",
          "maxLength": 64
        },
        "photoData": {
          "type": "string",
          "description": "Base64 encoded JPEG data URL of the compressed image",
          "maxLength": 500000
        },
        "uploaderName": {
          "type": "string",
          "description": "Display name of the traveler",
          "maxLength": 100
        },
        "uploaderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the uploader",
          "maxLength": 128
        },
        "caption": {
          "type": "string",
          "description": "Optional short caption",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["spotId", "photoData", "uploaderName", "uploaderUid", "createdAt"]
    },
    "travelerProfile": {
      "title": "Traveler Profile",
      "description": "Traveler progress and tracker state in Dinajpur",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Traveler name",
          "maxLength": 100
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image data URL",
          "maxLength": 500000
        },
        "visitedUpazilas": {
          "type": "array",
          "description": "List of visited upazila IDs"
        },
        "themeId": {
          "type": "string",
          "description": "Selected map color theme ID",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "name", "visitedUpazilas", "updatedAt"]
    },
    "siteStats": {
      "title": "Site Visitor Statistics",
      "description": "Exact total visitor count for Hangout Dinajpur landing page",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Total visitor count"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last visit timestamp"
        }
      },
      "required": ["count", "updatedAt"]
    },
    "generatedPoster": {
      "title": "Generated Travel Map Poster",
      "description": "Record of a traveler generating or downloading a PNG, JPG, or PDF travel map poster",
      "type": "object",
      "properties": {
        "travelerName": {
          "type": "string",
          "description": "Name entered on the generated poster",
          "maxLength": 100
        },
        "format": {
          "type": "string",
          "description": "Downloaded file format (png, jpg, or pdf)",
          "maxLength": 10
        },
        "visitedUpazilas": {
          "type": "array",
          "description": "List of visited upazila IDs included on the poster"
        },
        "visitedCount": {
          "type": "integer",
          "description": "Number of visited upazilas"
        },
        "progressPercent": {
          "type": "integer",
          "description": "Completion percentage (0 to 100)"
        },
        "themeId": {
          "type": "string",
          "description": "Selected map theme ID",
          "maxLength": 32
        },
        "posterPreview": {
          "type": "string",
          "description": "Compressed JPEG base64 preview of the generated poster image",
          "maxLength": 500000
        },
        "userId": {
          "type": "string",
          "description": "Optional UID or guest identifier",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the poster was generated"
        }
      },
      "required": [
        "travelerName",
        "format",
        "visitedUpazilas",
        "visitedCount",
        "progressPercent",
        "themeId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/spotPhotos/{photoId}": {
      "schema": "spotPhoto",
      "description": "Public gallery of spot photos contributed by travelers"
    },
    "/travelers/{userId}": {
      "schema": "travelerProfile",
      "description": "Traveler profiles and visited upazilas tracker data"
    },
    "/siteStats/{statId}": {
      "schema": "siteStats",
      "description": "Global site visitor counter document"
    },
    "/generatedPosters/{posterId}": {
      "schema": "generatedPoster",
      "description": "All generated and downloaded PNG, JPG, and PDF travel map posters"
    }
  }
}
