rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSpotPhoto(data) {
      return data.keys().hasAll(['spotId', 'photoData', 'uploaderName', 'uploaderUid', 'createdAt']) &&
             data.keys().hasOnly(['spotId', 'photoData', 'uploaderName', 'uploaderUid', 'caption', 'createdAt']) &&
             data.spotId is string && data.spotId.size() > 0 && data.spotId.size() <= 64 &&
             data.photoData is string && data.photoData.size() > 0 && data.photoData.size() <= 150000 &&
             data.uploaderName is string && data.uploaderName.size() > 0 && data.uploaderName.size() <= 100 &&
             data.uploaderUid == request.auth.uid &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 200)) &&
             data.createdAt == request.time;
    }

    function isValidTraveler(data) {
      return data.keys().hasAll(['userId', 'name', 'visitedUpazilas', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'name', 'avatar', 'visitedUpazilas', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 150000)) &&
             data.visitedUpazilas is list && data.visitedUpazilas.size() <= 13 &&
             data.updatedAt == request.time;
    }

    // Public Spot Gallery photos contributed by travelers
    match /spotPhotos/{photoId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(photoId) && isValidSpotPhoto(incoming());
      allow delete: if isSignedIn() && existing().uploaderUid == request.auth.uid;
      allow update: if false;
    }

    // Traveler Profiles & Tracker
    match /travelers/{userId} {
      allow read: if true;
      allow create, update: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidTraveler(incoming());
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
